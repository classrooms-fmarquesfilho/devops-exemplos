{
  "name": "Sprint 2 base",
  "image": "mcr.microsoft.com/devcontainers/universal:2-linux",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "github.vscode-github-actions"
      ]
    }
  },
  "postCreateCommand": "pip install -r requirements.txt -r requirements-dev.txt",
  "forwardPorts": [8080]
}